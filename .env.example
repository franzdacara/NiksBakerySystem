# Copy this file to .env and fill in your Supabase project values.

# Used by the app (Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Direct Postgres connection (Supabase Dashboard > Connect > Database)
DATABASE_NAME=postgres
DATABASE_HOST=db.your-project-ref.supabase.co
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your-database-password
